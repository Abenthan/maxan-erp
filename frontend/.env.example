# ============================================================
# maxan-erp frontend — SSO con maxan-auth (auth.maxansistemas.com)
# ============================================================
# Poner VITE_AUTH_DELEGATED=true SOLO cuando maxan-auth esté validado.
# Mientras sea "false" (o el archivo no exista), el ERP funciona como hoy.
#
# DEV (probar contra auth local):
#   VITE_AUTH_DELEGATED=true
#   VITE_AUTH_URL=http://localhost:5175
#
# PROD:
#   VITE_AUTH_DELEGATED=true
#   VITE_AUTH_URL=https://auth.maxansistemas.com

VITE_AUTH_DELEGATED=false
VITE_AUTH_URL=https://auth.maxansistemas.com
